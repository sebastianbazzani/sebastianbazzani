---
import { projects } from "../data/projects";
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700&display=swap" rel="stylesheet">

  <title>Sebastián Sarmiento</title>

  <style>


@font-face {
  font-family: "General Sans";
  src: url("/fonts/GeneralSans-Regular.woff2") format("woff2");
  font-weight: 400;
}

@font-face {
  font-family: "General Sans";
  src: url("/fonts/GeneralSans-Medium.woff2") format("woff2");
  font-weight: 500;
}

@font-face {
  font-family: "General Sans";
  src: url("/fonts/GeneralSans-Semibold.woff2") format("woff2");
  font-weight: 600;
}

@font-face {
  font-family: "General Sans";
  src: url("/fonts/GeneralSans-Bold.woff2") format("woff2");
  font-weight: 700;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:#f8f7f4;
      color:#111;
    }

header{
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  padding:28px 24px;
  margin-bottom:28px;
}

header a{
  text-decoration:none;
  color:#111;
  font-family:"General Sans", sans-serif;
  font-size:18px;
  font-weight:500;
  letter-spacing:-0.02em;
}

    header a:first-child{
      justify-self:start;
    }

.logo{
    justify-self:center;
    font-family:"General Sans", sans-serif;
    font-size:22px;
    font-weight:600;
    letter-spacing:-0.03em;
}

    header a:last-child{
      justify-self:end;
    }

    main{
      padding:0 24px 80px;
    }

    .grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:12px;
    }

    .card{
      text-decoration:none;
      color:inherit;
      cursor:pointer;
    }

    .thumb{
      width:100%;
      display:block;
      aspect-ratio:4/5;
      object-fit:cover;
      background:#ddd;
      transition:.25s;
    }

    .card:hover .thumb{
      opacity:.85;
    }

    h2{
      margin-top:8px;
      font-size:14px;
      font-weight:500;
    }

.row{
  display:grid;
  gap:12px;
  margin-bottom:34px;
}

.posters{
  grid-template-columns:repeat(5,1fr);
}

.poster img{
  width:100%;
  display:block;
}

.sixty-forty img,
.forty-sixty img{
    width:100%;
    height:420px;
    object-fit:cover;
    display:block;
}
.poster{
  text-decoration:none;
  color:inherit;
}

.three{
    grid-template-columns:repeat(3,1fr);
}

.two{
    grid-template-columns:repeat(2,1fr);
}
.sixty-forty{
    display:grid;
    grid-template-columns:3fr 2fr;
    gap:24px;
    margin-bottom:34px;
    align-items:start;
}

.forty-sixty{
    display:grid;
    grid-template-columns:2fr 3fr;
    gap:24px;
    margin-top:20px;  
    margin-bottom:34px;
    align-items:start;
}

.seventy-thirty{
    display:grid;
    grid-template-columns:7fr 3fr;
    gap:24px;
    margin-bottom:34px;
    align-items:start;
}

.seventy-thirty img{
    width:100%;
    height:600px;
    object-fit:cover;
    display:block;
}

.landscape img{
    width:100%;
    display:block;
}

.caption{
  margin-top:14px;
  font-family:"General Sans", sans-serif;
  font-size:18px;
  font-weight:400;
  letter-spacing:-0.02em;
  color:#111;
}

footer{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    padding:40px 24px;
    margin-top:60px;
}

footer a{
    text-decoration:none;
    color:#111;
    font-family:"General Sans", sans-serif;
    font-size:18px;
    font-weight:500;
    letter-spacing:-0.02em;
}

footer a:first-child{
    justify-self:start;
}

footer .logo{
    justify-self:center;
    font-family:"General Sans", sans-serif;
    font-size:22px;
    font-weight:600;
    letter-spacing:-0.03em;
}

footer a:last-child{
    justify-self:end;
}
  </style>
</head>

<body>

